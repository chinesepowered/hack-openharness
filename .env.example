# Server-only. Never prefix these with NEXT_PUBLIC_.
# HarnessRouter key (sk-hr-...). Locally it can live in the one-line file .env.harnessrouter instead.
HR_API_KEY=
# Signs the session cookie. 32+ random bytes, e.g. `openssl rand -hex 32`. Auto-generated in .data/ for local dev.
SESSION_SECRET=
# GitHub OAuth app (https://github.com/settings/developers). Callback: <APP_URL>/api/auth/github/callback
# Leave empty to run in demo mode (public repos, no GitHub sign-in).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
APP_URL=http://localhost:3000
